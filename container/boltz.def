# Apptainer definition file, equivalent to the Dockerfile next to it.
#
# This is here for reference and teaching. The Dockerfile is the one actually
# used, because GitHub's runners build Docker images and Apptainer converts
# them on pull. Building THIS file requires a Linux machine where you have
# root or fakeroot, which you do not have on Fox:
#
#     apptainer build --fakeroot boltz.sif boltz.def
#
# The structure of a definition file is worth knowing even if you never run
# it. A header saying what to start from, then sections that each do one job.

Bootstrap: docker
From: nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

%labels
    Description Boltz-2 for the CCTX2 structure prediction project
    BoltzVersion 2.2.1

%environment
    # Sourced every time the container starts.
    export BOLTZ_CACHE=${BOLTZ_CACHE:-/opt/boltz_cache}
    export PYTHONDONTWRITEBYTECODE=1
    export LC_ALL=C

%post
    # Runs once, at build time, inside the image.
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3.11-dev python3-pip git ca-certificates
    rm -rf /var/lib/apt/lists/*

    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1
    python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

    # Pinned on purpose. The whole point of the image is that these do not move.
    python3 -m pip install --no-cache-dir \
        boltz==2.2.1 \
        cuequivariance-torch \
        cuequivariance-ops-torch-cu12

    python3 -m pip install --no-cache-dir \
        numpy pandas pyyaml gemmi biopython

    mkdir -p /opt/boltz_cache
    python3 -m pip list --format=freeze > /opt/versions.txt

%runscript
    # What runs on `apptainer run image.sif ...`
    exec boltz "$@"

%help
    Boltz-2 for the CCTX2 project.

    Run a prediction:
        apptainer exec --nv \
            --bind $HOME/boltz_cache:/opt/boltz_cache \
            boltz.sif boltz predict input.yaml --out_dir results/

    See exactly which versions are inside:
        apptainer exec boltz.sif cat /opt/versions.txt

    --nv exposes the host NVIDIA drivers. Without it the container sees no GPU.
